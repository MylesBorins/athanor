{
  "name": "athanor",
  "version": "3.2.0",
  "description": "Personal LLM alchemy for Apple Silicon: discover, run, and publish MLX and llama.cpp models",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mylesborins/athanor.git"
  },
  "homepage": "https://github.com/mylesborins/athanor#readme",
  "bugs": {
    "url": "https://github.com/mylesborins/athanor/issues"
  },
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "athanor": "./bin/athanor"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "start": "tsx src/index.tsx",
    "dev": "node scripts/dev-watch.mjs",
    "build": "tsc && node -e \"const fs=require('fs'); const path=require('path'); const walk=d=>{ for (const entry of fs.readdirSync(d,{withFileTypes:true})) { const p=path.join(d,entry.name); if (entry.isDirectory()) walk(p); else if (/\\.test\\.(js|js\\.map|d\\.ts|d\\.ts\\.map)$/.test(entry.name)) fs.unlinkSync(p); } }; walk('dist'); fs.copyFileSync('src/pull/hf_pull.py','dist/pull/hf_pull.py')\"",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ink": "^7.0.0",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
