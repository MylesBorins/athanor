{
  "name": "athanor",
  "version": "0.1.0",
  "description": "personal LLM alchemy",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "athanor": "./bin/athanor"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "start": "tsx src/index.tsx",
    "build": "tsc && node -e \"require('fs').copyFileSync('src/pull/hf_pull.py','dist/pull/hf_pull.py')\"",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ink": "^7.0.0",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  }
}
